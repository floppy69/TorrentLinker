#!/bin/sh
# Native DSM package service. Never run torrentlinker.container_entrypoint here.
set -eu

PACKAGE="TorrentLinkerSynology"
DEST="${SYNOPKG_PKGDEST:-/var/packages/$PACKAGE/target}"
VAR="${SYNOPKG_PKGVAR:-/var/packages/$PACKAGE/var}"
PYTHON="$DEST/runtime/bin/python3.12"
CONFIG="$VAR/config"
SECRET="$VAR/secrets/web-password"
SHARE="${TL_SYNOLOGY_SHARE_DIR:-/var/packages/$PACKAGE/shares/TorrentLinker-Config}"
SHARED_PASSWORD="$SHARE/web-password.txt"
RUN="$VAR/run"
PIDFILE="$RUN/torrentlinker.pid"
LOG="$VAR/logs/torrentlinker.log"

read_pid() {
    [ -f "$PIDFILE" ] || return 1
    pid=$(sed -n '1p' "$PIDFILE")
    case "$pid" in
        ''|*[!0-9]*) return 1 ;;
    esac
    [ "$pid" -gt 1 ] || return 1
    return 0
}

running() {
    read_pid || return 1
    kill -0 "$pid" 2>/dev/null || return 1
    [ -r "/proc/$pid/cmdline" ] || return 1
    tr '\000' '\n' < "/proc/$pid/cmdline" | grep -Fxq 'torrentlinker.web.server'
}

# DSM's data-share worker creates the visible share before the package starts.
# File Station users may change this password; it is reloaded on the next start.
# The private install-time secret is only used to initialize the share once.
prepare_shared_password() {
    # DSM deliberately exposes the data-share through a symlink here.
    if [ ! -d "$SHARE" ]; then
        echo "Missing Synology shared folder TorrentLinker-Config: $SHARE" >&2
        return 1
    fi
    if [ -L "$SHARED_PASSWORD" ]; then
        echo "Refusing a symlink as Web password file" >&2
        return 1
    fi
    if [ ! -e "$SHARED_PASSWORD" ]; then
        if [ ! -s "$SECRET" ] || [ ! -r "$SECRET" ]; then
            echo "Missing initial Web password: $SECRET" >&2
            return 1
        fi
        # Never overwrite a password saved by the administrator or a previous install.
        ( umask 077; set -C; cat "$SECRET" > "$SHARED_PASSWORD" ) || {
            echo "Cannot initialize password in $SHARE" >&2
            return 1
        }
        chmod 600 "$SHARED_PASSWORD"
    fi
    if [ ! -f "$SHARED_PASSWORD" ] || [ ! -r "$SHARED_PASSWORD" ]; then
        echo "Web password cannot be read: $SHARED_PASSWORD" >&2
        return 1
    fi
    # The original server strips the final newline; reject multiline files.
    password=$(cat "$SHARED_PASSWORD") || return 1
    bytes=$(wc -c < "$SHARED_PASSWORD") || return 1
    if [ "${#password}" -lt 12 ] || [ "${#password}" -gt 128 ] || \
       [ "$bytes" -gt "$(( ${#password} + 1 ))" ]; then
        echo "Invalid Web password: use 12-128 characters on one line" >&2
        return 1
    fi
}

start() {
    if running; then
        echo "TorrentLinker is already running."
        return 0
    fi
    if [ -e "$PIDFILE" ]; then
        if read_pid && kill -0 "$pid" 2>/dev/null; then
            echo "Refusing to reuse PID file for an unrelated live process" >&2
            return 1
        fi
        rm -f "$PIDFILE"
    fi
    if [ ! -x "$PYTHON" ]; then
        echo "Missing packaged Python executable: $PYTHON" >&2
        return 1
    fi
    prepare_shared_password || return 1
    umask 077
    mkdir -p "$RUN" "$CONFIG" "$VAR/logs" "$VAR/tmp"
    chmod 700 "$RUN" "$CONFIG" "$VAR/logs" "$VAR/tmp"
    export PYTHONHOME="$DEST/runtime"
    export PYTHONPATH="$DEST/runtime/lib/python3.12/site-packages"
    export PYTHONNOUSERSITE="1"
    export LD_LIBRARY_PATH="$DEST/native/lib:$DEST/runtime/lib"
    export PATH="$DEST/native/bin:$DEST/runtime/bin:/usr/sbin:/usr/bin:/sbin:/bin"
    export TMPDIR="$VAR/tmp"
    export TL_WEB_HOST="0.0.0.0"
    export TL_WEB_PORT="8787"
    "$PYTHON" -m torrentlinker.web.server \
        --host "$TL_WEB_HOST" --port "$TL_WEB_PORT" \
        --config "$CONFIG" --password-file "$SHARED_PASSWORD" \
        >> "$LOG" 2>&1 &
    pid=$!
    printf '%s\n' "$pid" > "$PIDFILE"
    sleep 2
    if running; then
        echo "TorrentLinker started on port 8787."
        return 0
    fi
    rm -f "$PIDFILE"
    echo "TorrentLinker terminated during startup. Check $LOG" >&2
    return 1
}

stop() {
    if ! running; then
        if [ -e "$PIDFILE" ]; then
            echo "Cannot safely stop an unknown process recorded in $PIDFILE" >&2
            return 1
        fi
        return 0
    fi
    kill -TERM "$pid"
    i=0
    while [ "$i" -lt 30 ]; do
        if ! running; then
            rm -f "$PIDFILE"
            return 0
        fi
        sleep 1
        i=$((i + 1))
    done
    echo "TorrentLinker did not stop within 30 seconds; refusing SIGKILL." >&2
    return 1
}

case "${1:-}" in
    start) start ;;
    stop) stop ;;
    prepare-password) prepare_shared_password ;;
    status)
        if running; then
            exit 0
        elif [ -f "$PIDFILE" ]; then
            exit 1
        else
            exit 3
        fi
        ;;
    *) echo "Usage: $0 {start|stop|status|prepare-password}" >&2; exit 2 ;;
esac

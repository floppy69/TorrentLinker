# PyInstaller spec: one-file .exe on Windows, one-dir build on Linux (wrapped into an AppImage),
# .app bundle on macOS (wrapped into a .dmg).
import sys
from importlib import metadata
from pathlib import Path

from PyInstaller.utils.hooks import (
    collect_data_files,
    collect_dynamic_libs,
    collect_submodules,
    copy_metadata,
)

windows = sys.platform == "win32"
macos = sys.platform == "darwin"

datas = (
    collect_data_files("torrentlinker")
    + collect_data_files("tzdata")
    + collect_data_files("guessit")
    + collect_data_files("babelfish")
    + copy_metadata("torrentlinker")
    + copy_metadata("PySide6")  # support reports must identify the bundled Qt bindings
    + copy_metadata("mcp")
    + copy_metadata("mcp-types")
)
docs = Path(SPECPATH).parent / "docs"
datas += [(str(docs / "README.md"), "docs")]
datas += [
    (str(file), str(Path("docs") / file.parent.relative_to(docs)))
    for file in (docs / "guide").rglob("*")
    if file.suffix in {".md", ".png"}
]
hiddenimports = (
    collect_submodules("keyring.backends")
    + collect_submodules("guessit")
    + collect_submodules("babelfish")
    + collect_submodules("rebulk")
    # mutagen picks its format readers by file type (the Audio and Ebook uploads)
    + collect_submodules("mutagen")
    + collect_submodules("uvicorn")
    # Imported only when a SOCKS proxy is set (httpx, and requests for qBittorrent)
    + collect_submodules("socksio")
    + ["socks", "sockshandler", "PySide6.QtMultimedia", "PySide6.QtMultimediaWidgets"]
    # The Upload tab's 3D view is a QML scene, which PyInstaller cannot see from imports
    + ["PySide6.QtQuick", "PySide6.QtQuick3D", "PySide6.QtQuickWidgets", "PySide6.QtQml"]
    # The bundled Catalogue's key, generated by the release build and imported by name
    + (["torrentlinker._catalogue_key"] if (Path(SPECPATH).parent / "src/torrentlinker/_catalogue_key.py").exists() else [])
)
# libmediainfo, which pymediainfo's wheels carry (ADR-0012)
binaries = collect_dynamic_libs("pymediainfo")
# Community embeds the shared bundled view; PyInstaller’s Qt hooks include its renderer.
excludes = ["tkinter"]

a = Analysis(
    ["launcher.py"],
    pathex=["../src"],
    binaries=binaries,
    datas=datas,
    hiddenimports=hiddenimports,
    excludes=excludes,
)
pyz = PYZ(a.pure)

if windows:
    exe = EXE(
        pyz,
        a.scripts,
        a.binaries,
        a.datas,
        name="TorrentLinker",
        console=False,
        icon="../src/torrentlinker/assets/icon.png",
    )
else:
    exe = EXE(pyz, a.scripts, exclude_binaries=True, name="torrentlinker", console=False)
    coll = COLLECT(exe, a.binaries, a.datas, name="torrentlinker")

if macos:
    app = BUNDLE(
        coll,
        name="TorrentLinker.app",
        icon="../src/torrentlinker/assets/icon.png",
        bundle_identifier="io.github.vietnoirien.torrentlinker",
        version=metadata.version("torrentlinker"),
        info_plist={"NSHighResolutionCapable": True, "LSApplicationCategoryType": "public.app-category.utilities"},
    )
